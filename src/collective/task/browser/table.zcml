<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="collective.task"
    >

  <adapter
      factory=".table.TitleColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="TitleColumn"
      zcml:condition="not-installed imio.prettylink"
      />

  <adapter
      factory=".table.PrettyLinkTitleColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="TitleColumn"
      zcml:condition="installed imio.prettylink"
      />

  <adapter
      factory=".table.DueDateColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="DueDateColumn"
      />

  <adapter
      factory=".table.EnquirerColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="EnquirerColumn"
      />

  <adapter
      factory=".table.AssignedGroupColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="AssignedGroupColumn"
      />

  <adapter
      factory=".table.AssignedUserColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="AssignedUserColumn"
      />

  <adapter
      factory=".table.ReviewStateColumn"
      provides="z3c.table.interfaces.IColumn"
      for="zope.interface.Interface
           zope.interface.Interface
           .table.TasksTable"
      name="ReviewStateColumn"
      />

</configure>
